# Local Python and build output
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/
work/
reports/
outputs/
# Go Windows version-resource objects (generated per release by
# packaging/build_windows_go.ps1, removed after the build).
*.syso

# Run profiles, state and protected credentials
profile/
profiles/
vault/
# ...but not the Go vault package itself (source code, not credentials):
# the bare `vault/` rule above also matches native/core/internal/vault/.
!native/core/internal/vault/
*.dpapi
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*
*.lock
!requirements.lock
.env
.env.*
!.env.example
*cookie*.txt
*cookie*.json
*credentials*.json
*secret*.json
*auth*.txt

# Private implementation records and user snapshots
docs/specifications/
docs/trace-*.jsonl
docs/legacy_inventory.*
docs/packaging-*.json
*.lnk
*.log
*.zip
*.torrent
*.ncm
!tests/fixtures/providers/synthetic.ncm
*.lrc

# Local OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
